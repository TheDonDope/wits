{
  "$schema": "./node_modules/@angular/service-worker/config/schema.json",
  "index": "/index.html",
  "assetGroups": [
    {
      "name": "app",
      "installMode": "prefetch",
      "resources": {
        "files": ["/favicon.svg", "/index.csr.html", "/index.html", "/verify.html", "/manifest.webmanifest", "/*.css", "/*.js", "/wits.wasm"]
      }
    },
    {
      "name": "assets",
      "installMode": "prefetch",
      "updateMode": "prefetch",
      "resources": {
        "files": ["/icons/**", "/media/**", "/**/*.(svg|woff|woff2|ttf|png)"]
      }
    },
    {
      "name": "guide",
      "installMode": "lazy",
      "updateMode": "lazy",
      "resources": {
        "files": ["/guide/**"]
      }
    },
    {
      "name": "ocr",
      "installMode": "lazy",
      "updateMode": "lazy",
      "resources": {
        "files": ["/ocr/**", "/pdf/**"]
      }
    }
  ]
}
